# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME=ORCA
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=orca_db
POSTGRES_USER=orca_user
POSTGRES_PASSWORD=orca_pass
DATABASE_URL=postgresql+asyncpg://orca_user:orca_pass@postgres:5432/orca_db

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=orca-satellite-images

# ─── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=orca-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Internal ──────────────────────────────────────────────────────────────────
INTERNAL_KEY=orca-internal-secret

# ─── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]

# ─── AI / LLM ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-google-gemini-api-key-here
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-pro
FALLBACK_TO_TEMPLATE=true

# ─── External APIs (all free, no key required for prototype) ───────────────────
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GBIF_BASE_URL=https://api.gbif.org/v1
# Optional (free registration at aishub.net):
AISHUB_USERNAME=

# ─── Notification (optional for prototype) ─────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=

# ─── Agent Settings ────────────────────────────────────────────────────────────
AGENT_MODE=loop
AGENT_CYCLE_INTERVAL_MINUTES=15
VESSEL_UPDATE_INTERVAL_MINUTES=2
SATELLITE_ANALYSIS_INTERVAL_HOURS=6
ALERT_THRESHOLD_PROBABILITY=0.65
ALERT_THRESHOLD_CONFIDENCE=0.60
